{
  "name": "@readyou/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "worker:start": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "worker:prod": "tsx --env-file-if-exists=../../.env --env-file=../../.env.production.local src/worker.ts",
    "migrate:prod": "tsx --env-file-if-exists=../../.env --env-file=../../.env.production.local src/migrate.ts",
    "engine": "tsx --env-file-if-exists=../../.env src/cli/engine.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@readyou/providers": "*",
    "@readyou/shared": "*",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.7",
    "tsx": "^4.23.15"
  }
}
