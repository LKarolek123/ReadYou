# Skopiuj do .env i uzupełnij. Nigdy nie commituj prawdziwych sekretów.

# Tryb aplikacji: development | production
NODE_ENV=development

# Baza (docker compose: 127.0.0.1:15432)
DATABASE_URL=postgres://readyou:readyou@127.0.0.1:15432/readyou

# Publiczny adres aplikacji widziany przez przeglądarkę.
# W dev Vite (5173) proxuje /api do API (3001), więc cookies są first-party.
APP_URL=http://localhost:5173
API_PORT=3001

# Better Auth — wygeneruj np.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Logowanie przez Google (opcjonalne). Bez tych zmiennych przycisk Google jest ukryty.
# Authorized redirect URI w Google Cloud Console: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail. EMAIL_PROVIDER=smtp-dev wysyła wyłącznie do lokalnego Mailpit (http://127.0.0.1:8025).
EMAIL_PROVIDER=smtp-dev
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Produkcja (EMAIL_PROVIDER=smtp): usługa SMTP z uwierzytelnionym nadawcą (SPF/DKIM) i prawdziwy EMAIL_FROM.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Raport tygodniowy: po takim opóźnieniu (np. worker był wyłączony) nie wysyłamy już raportu z piątku.
REPORT_MAX_DELAY_HOURS=12
EMAIL_FROM="ReadYou <no-reply@readyou.local>"

# Embeddingi: lokalny model multilingual-e5-small (~120 MB, pobierany przy pierwszym użyciu
# do EMBEDDING_CACHE_DIR). Koszt 0 $, tekst nie opuszcza serwera. `disabled` wyłącza wektory.
EMBEDDING_PROVIDER=e5-local
EMBEDDING_CACHE_DIR=.cache/models

# Worker zadań w tle (npm run worker): odstęp odpytywania kolejki w ms.
WORKER_POLL_MS=1000

# --- Odkrywanie treści -------------------------------------------------------
# Brave Search API (News Search). Konto zakłada właściciel; wyniki są używane tylko tymczasowo
# (regulamin Brave §3(b)(i)) — w bazie zapisujemy dane ze stron wydawców.
BRAVE_SEARCH_SECRET_KEY=
# Twarde limity zapytań (kredyt 5 $/mies. ≈ 1000 zapytań).
BRAVE_DAILY_QUERY_LIMIT=30
BRAVE_MONTHLY_QUERY_LIMIT=900
# Kontakt w User-Agencie bota „ReadYouBot” (adres strony z informacją o bocie). Domyślnie APP_URL.
CRAWLER_CONTACT=
# Języki treści, maksymalny wiek artykułów (dni) i czas przechowywania pełnego tekstu (dni).
CONTENT_LANGUAGES=pl,en
CONTENT_MAX_AGE_DAYS=14
CONTENT_TEXT_TTL_DAYS=14
# Próg marginesu trafności (kalibracja: docs/implementation-plan.md).
RELEVANCE_THRESHOLD=0
EXTRACT_PER_RUN=10
# Obrazy wydawców (og:image) na kartach. Domyślnie false: adres obrazu to metadane, nie licencja.
SHOW_SOURCE_IMAGES=false

# --- Streszczenia (Claude Haiku 5.5) ------------------------------------------
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5
# Twarde limity kosztu (USD, szacunek ze stawek poniżej). Po przekroczeniu: brak nowych streszczeń.
LLM_DAILY_BUDGET_USD=0.16
LLM_MONTHLY_BUDGET_USD=5
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50

# --- Wydarzenia, kluby i miejsca ---------------------------------------------
# Strony organizatorów bez danych strukturalnych: ekstrakcja AI (cytaty) tylko po zmianie strony,
# najwyżej tyle stron dziennie (koszt wliczony w budżet LLM powyżej).
EVENT_LLM_PAGES_PER_DAY=15
# Wyszukiwanie stron wydarzeń w Brave (część dziennego limitu BRAVE_DAILY_QUERY_LIMIT).
EVENT_SEARCH_DAILY_QUERIES=4
EVENT_SEARCH_PAGES_PER_RUN=8
# Kluby i miejsca: OpenStreetMap (Overpass API), bez klucza; dane ODbL z atrybucją.
